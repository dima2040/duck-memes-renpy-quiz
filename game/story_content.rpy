    def story_scene_by_id(scene_id):
        try:
            return STORY_SCENES[scene_id]
        except KeyError:
            raise Exception("Unknown story scene '{}'.".format(scene_id))


    def validate_story_content():
        known_speakers = {"mbk", "neo", "p"}

        for scene_id, lines in STORY_SCENES.items():
            if not lines:
                raise Exception("Story scene '{}' has no lines.".format(scene_id))

            for speaker_id, line_text in lines:
                if speaker_id not in known_speakers:
                    raise Exception("Story scene '{}' uses unknown speaker '{}'.".format(scene_id, speaker_id))

                if not line_text:
                    raise Exception("Story scene '{}' has an empty line.".format(scene_id))

        return True


    STORY_CONTENT_IS_VALID = validate_story_content()
